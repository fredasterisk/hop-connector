<?xml version="1.0"?>
<ruleset name="Espace client">
	<description>WordPress Coding Standards for the Espace client connector.</description>

	<file>.</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>dist/*</exclude-pattern>
	<!-- A command-line tool run on the agency's computer, never loaded by WordPress. -->
	<exclude-pattern>bin/*</exclude-pattern>
	<!-- Tests follow PHPUnit's naming, not WordPress's. -->
	<exclude-pattern>tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Exceptions are caught inside the connector and sent back in a JSON
		     WP_Error, never printed as HTML. -->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
		<!-- The methods that throw catch their own exceptions. -->
		<exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fred-espace-client"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				
				<element value="fred_espace_client"/>
			</property>
		</properties>
	</rule>
</ruleset>
