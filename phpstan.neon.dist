parameters:
	level: 5
	phpVersion: 70400
	paths:
		- hop-connector.php
		- uninstall.php
		- includes
	excludePaths:
		# Shared file, copied as is from its reference.
		- includes/github-updater.php
	bootstrapFiles:
		- tests/phpstan-constants.php
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- includes/github-updater.php
	dynamicConstantNames:
		- HOP_CONNECTOR_DENY
		- HOP_CONNECTOR_DISABLED
		- HOP_CONNECTOR_RESCUE
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# The constant itself, on purpose: wp_is_file_mod_allowed() passes
		# through a filter that any plugin could use to lift the switch.
		-
			identifier: phpstanWP.wpConstant.fetch
			path: includes/class-hop-connector-admin.php
			count: 1
