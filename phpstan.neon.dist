parameters:
	level: 5
	phpVersion: 70400
	paths:
		- fred-espace-client.php
		- uninstall.php
		- includes
	bootstrapFiles:
		- tests/phpstan-constants.php
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
	dynamicConstantNames:
		- FRED_ESPACE_CLIENT_DENY
		- FRED_ESPACE_CLIENT_DISABLED
		- FRED_ESPACE_CLIENT_RESCUE
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# The constant itself, on purpose: wp_is_file_mod_allowed() passes
		# through a filter that any plugin could use to lift the switch.
		-
			identifier: phpstanWP.wpConstant.fetch
			path: includes/class-fred-espace-client-admin.php
			count: 1
